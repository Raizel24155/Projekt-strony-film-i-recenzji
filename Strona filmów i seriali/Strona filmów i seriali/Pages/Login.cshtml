@page
@model Strona_filmów_i_seriali.Pages.LoginModel

@{
    ViewData["Title"] = "Logowanie i rejestracja";
}
<!DOCTYPE html>
<html lang="pl">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>CineVerse - Logowanie</title>

        <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />


    </head>
    <body>
        <div class="account-page">

            <a href="/" class="account-logo">Cine<span>Verse</span></a>

            <a href="/" class="back-home">← Powrót do strony głównej</a>

            <div class="account-container">

                <div class="account-header">
                    <span class="section-label">CINEVERSE COMMUNITY</span>
                    <h1 id="auth-title">Witaj ponownie!</h1>
                    <p id="auth-description">
                        Zaloguj się, aby odkrywać świat kina.
                    </p>
                </div>

                <div class="auth-tabs">
                    <button class="auth-tab active" id="login-tab"
                            onclick="showAuth('login')">
                        Logowanie
                    </button>

                    <button class="auth-tab" id="register-tab"
                            onclick="showAuth('register')">
                        Rejestracja
                    </button>
                </div>

                <!-- LOGIN -->
                <form method="post" asp-page-handler="Login"
                      id="login-form" class="auth-form">

                    <div class="form-group">
                        <label for="LoginEmail">Adres e-mail</label>
                        <input type="email" id="LoginEmail"
                               name="LoginEmail"
                               placeholder="twoj@email.com" required />
                    </div>

                    <div class="form-group">
                        <label for="LoginPassword">Hasło</label>
                        <input type="password" id="LoginPassword"
                               name="LoginPassword"
                               placeholder="Wprowadź hasło" required />
                    </div>

                    <div class="remember">
                        <input type="checkbox" name="RememberMe" id="remember" />
                        <label for="remember">Zapamiętaj mnie</label>
                    </div>

                    <button type="submit" class="submit-button">
                        Zaloguj się
                    </button>

                    <p class="auth-switch">
                        Nie masz konta?
                        <a href="javascript:void(0)"
                           onclick="showAuth('register')">Zarejestruj się</a>
                    </p>
                </form>

                <!-- REGISTER -->
                <form method="post" asp-page-handler="Register"
                      id="register-form" class="auth-form hidden">

                    <div class="form-group">
                        <label for="RegisterUsername">Nazwa użytkownika</label>
                        <input type="text" id="RegisterUsername"
                               name="RegisterUsername"
                               placeholder="Twoja nazwa użytkownika" required />
                    </div>

                    <div class="form-group">
                        <label for="RegisterEmail">Adres e-mail</label>
                        <input type="email" id="RegisterEmail"
                               name="RegisterEmail"
                               placeholder="twoj@email.com" required />
                    </div>

                    <div class="form-group">
                        <label for="RegisterPassword">Hasło</label>
                        <input type="password" id="RegisterPassword"
                               name="RegisterPassword"
                               placeholder="Utwórz hasło" required />
                    </div>

                    <div class="form-group">
                        <label for="ConfirmPassword">Powtórz hasło</label>
                        <input type="password" id="ConfirmPassword"
                               name="ConfirmPassword"
                               placeholder="Powtórz hasło" required />
                    </div>

                    <button type="submit" class="submit-button">
                        Utwórz konto
                    </button>

                    <p class="auth-switch">
                        Masz już konto?
                        <a href="javascript:void(0)"
                           onclick="showAuth('login')">Zaloguj się</a>
                    </p>
                </form>

            </div>

            <p class="account-footer">
                © 2026 CineVerse. Wszystkie prawa zastrzeżone.
            </p>

        </div>
        <script>
                function showAuth(type) {

                    const loginForm = document.getElementById("login-form");
                    const registerForm = document.getElementById("register-form");

                    const loginTab = document.getElementById("login-tab");
                    const registerTab = document.getElementById("register-tab");

                    const title = document.getElementById("auth-title");
                    const description = document.getElementById("auth-description");

                    if (type === "login") {

                        loginForm.classList.remove("hidden");
                        registerForm.classList.add("hidden");

                        loginTab.classList.add("active");
                        registerTab.classList.remove("active");

                        title.textContent = "Witaj ponownie!";
                        description.textContent = "Zaloguj się, aby odkrywać świat kina.";

                    } else {

                        loginForm.classList.add("hidden");
                        registerForm.classList.remove("hidden");

                        loginTab.classList.remove("active");
                        registerTab.classList.add("active");

                        title.textContent = "Dołącz do CineVerse!";
                        description.textContent = "Utwórz konto i poznawaj nowe produkcje.";

                    }
                }
        </script>
    </body>
</html>
