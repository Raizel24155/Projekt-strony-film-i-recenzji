@page
@model Strona_filmów_i_seriali.Pages.DetailsModel

@{
    Layout = null;
    ViewData["Title"] = Model.Item!.Title;
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>CineVerse - @Model.Item.Title</title>

    <link rel="stylesheet"
          href="~/css/details.css"
          asp-append-version="true" />
</head>

<body>

<header class="main-header">
    <a asp-page="/Index" class="logo">CINEVERSE</a>

    @* <nav class="main-nav">
        <a asp-page="/Index">Strona główna</a>
        <a asp-page="/Catalog" asp-route-type="Film">Filmy</a>
        <a asp-page="/Catalog" asp-route-type="Serial">Seriale</a>
    </nav> *@

    <form method="get" asp-page="/Search" class="header-search">
        <input type="text" name="query" placeholder="Szukaj..." />
        <button type="submit">Szukaj</button>
    </form>

    <a asp-page="/Login" class="login-button">Zaloguj się</a>
</header>

<main class="details-container">

    <a asp-page="/Catalog" class="back-link">
        ← Powrót do katalogu
    </a>

    <section class="details-hero">

        <div class="details-poster">
            <span>@Model.Item.Title</span>
        </div>

        <div class="details-information">

            <span class="content-type">@Model.Item.Type</span>

            <h1>@Model.Item.Title</h1>

            <div class="details-meta">
                <span>@Model.Item.Year</span>
                <span>@Model.Item.Genre</span>
                <span>@Model.Item.Duration</span>
            </div>

            <div class="details-rating">
                <span class="star">★</span>
                <strong>@Model.Item.Rating.ToString("0.0")</strong>
                <span>/ 10</span>
            </div>

            <h2>Opis</h2>

            <p class="description">
                @Model.Item.Description
            </p>

            @if (Model.Item.Type == "Serial")
            {
                <div class="series-information">
                    <div>
                        <strong>@Model.Item.Seasons</strong>
                        <span>Sezony</span>
                    </div>

                    <div>
                        <strong>@Model.Item.Episodes</strong>
                        <span>Odcinki</span>
                    </div>
                </div>
            }

        </div>

    </section>

    <section class="cast-section">

        <h2>Obsada</h2>

        <div class="cast-list">

            @foreach (var actor in Model.Item.Cast)
            {
                <div class="cast-card">
                    <div class="cast-avatar">
                        @actor.Substring(0, 1)
                    </div>

                    <span>@actor</span>
                </div>
            }

        </div>

    </section>

        <section class="reviews-section">

            <div class="reviews-heading">
                <h2>Recenzje użytkowników</h2>
                <span>@Model.Reviews.Count recenzji</span>
            </div>

            <div class="add-review">

                <h3>Podziel się swoją opinią</h3>

                <form method="post"
                      asp-page-handler="AddReview"
                      asp-route-id="@Model.Item.Id">

                    <div class="review-form-group">
                        <label for="username">Twój pseudonim</label>

                        <input type="text"
                               id="username"
                               name="username"
                               maxlength="30"
                               placeholder="Wpisz swój pseudonim"
                               required />
                    </div>

                    <div class="review-form-group">
                        <label for="rating">Twoja ocena</label>

                        <select id="rating" name="rating" required>
                            <option value="10">10 - Arcydzieło</option>
                            <option value="9">9 - Świetny</option>
                            <option value="8">8 - Bardzo dobry</option>
                            <option value="7">7 - Dobry</option>
                            <option value="6">6 - Niezły</option>
                            <option value="5">5 - Przeciętny</option>
                            <option value="4">4 - Słaby</option>
                            <option value="3">3 - Bardzo słaby</option>
                            <option value="2">2 - Zły</option>
                            <option value="1">1 - Fatalny</option>
                        </select>
                    </div>

                    <div class="review-form-group">
                        <label for="content">Treść recenzji</label>

                        <textarea id="content"
                                  name="content"
                                  maxlength="1000"
                                  rows="5"
                                  placeholder="Co sądzisz o tej produkcji?"
                                  required></textarea>
                    </div>

                    <button type="submit" class="review-submit">
                        Dodaj recenzję
                    </button>

                </form>

            </div>

            <div class="reviews-list">

                @if (Model.Reviews.Any())
                {
                    @foreach (var review in Model.Reviews)
                    {
                        <article class="review-card">

                            <div class="review-top">

                                <div>
                                    <a asp-page="/Account"
                                       asp-route-username="@review.Username"
                                       class="review-username">

                                        @review.Username

                                    </a>

                                    <span class="review-date">
                                        @review.CreatedAt.ToString("dd.MM.yyyy")
                                    </span>
                                </div>

                                <div class="review-rating">
                                    ★ @review.Rating/10
                                </div>

                            </div>

                            <p>@review.Content</p>

                        </article>
                    }
                }
                else
                {
                    <p class="no-reviews">
                        Nie ma jeszcze żadnych recenzji.
                        Bądź pierwszą osobą, która podzieli się swoją opinią!
                    </p>
                }

            </div>

        </section>

</main>

</body>
</html>

